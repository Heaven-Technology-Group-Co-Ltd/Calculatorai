{
  "name": "calculate_project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "concurrently -n next,bot -c cyan,magenta \"next dev\" \"dotenv -e discord-bot/.env -- pnpm --filter admin-discord-bot dev\"",
    "dev:web": "next dev",
    "dev:bot": "dotenv -e discord-bot/.env -- pnpm --filter admin-discord-bot dev",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=1536' next build",
    "start": "concurrently -n next,bot -c cyan,magenta \"cross-env NODE_OPTIONS='--max-old-space-size=1024' next start\" \"dotenv -e discord-bot/.env -- pnpm --filter admin-discord-bot start\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "guardrails": "vitest run src/lib/quality-gates.test.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/supabase-js": "^2.106.1",
    "@types/canvas-confetti": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.577.0",
    "mathjs": "^15.1.1",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "nodemailer": "^8.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-window": "^2.3.0",
    "recharts": "2.15.3",
    "stripe": "^22.2.0",
    "swr": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^2.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
